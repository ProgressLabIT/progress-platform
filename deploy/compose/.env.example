# Copy to `.env` (gitignored) and edit for your environment. Used by
# `docker compose -f deploy/compose/sparkplug.yaml ...` for the local edge
# stack (bridge + sim) talking to a remote Progress cloud server.

# --- Cloud endpoints --------------------------------------------------------

# Endpoint URLs of the cloud Progress server. Demo posture is plain TCP / HTTPS
# with no broker auth (TLS + creds can be configured but are out of scope for v1.0).
PROGRESS_API_BASE_URL=https://demo.progresslab.io/api
PROGRESS_NATS_URL=nats://demo.progresslab.io:4222
PROGRESS_MQTT_URL=tcp://demo.progresslab.io:1883

# --- JWT bind mount ---------------------------------------------------------

# Host path holding the sparkplug bridge JWT (mode 0600).
# The container always reads /opt/progress/config/.sparkplug-token internally;
# this var only controls which host directory is bind-mounted in. JWT ships
# inside the demo-dataset bundle (DATA-DEMO-03) — copy the .sparkplug-token
# file into this directory before starting the bridge.
PROGRESS_SECRETS_DIR=/Users/you/.progress/secrets

# --- Phase 5 pump-anomaly automation (ADR-0010) -----------------------------

# Kill switch. Set to false then `up -d --force-recreate sparkplug_bridge`
# to disable firing without rebuilding the image.
SPARKPLUG_AUTOMATIONS_ENABLED=true

# IssueWithLinks fields. created_by/user_key/user_session_key MUST be
# consistent with the JWT's user — the bridge does NOT decode the JWT, so
# the operator sets these explicitly when preparing the demo bundle.
# issue_type_key picks which IssueType the fired issues use; the demo dataset
# should ship a dedicated equipment-anomaly type for a clean demo title.
PUMP_ANOMALY_USER_KEY=USR-SPARKPLUG-BRIDGE
PUMP_ANOMALY_USER_SESSION_KEY=sparkplug-bridge
PUMP_ANOMALY_CREATED_BY=User/USR-SPARKPLUG-BRIDGE
PUMP_ANOMALY_ISSUE_TYPE_KEY=
PUMP_ANOMALY_LINKED_WO_KEY=WO-DEMO-001
PUMP_ANOMALY_LINKED_PHASE_KEY=PH-DEMO-001

# Dwell + latch (ADR-0010 defaults 5s / 60s). Lower DWELL for fast-iteration
# testing when the sim's anomaly window is short.
PUMP_ANOMALY_DWELL_SECONDS=5
PUMP_ANOMALY_LATCH_SECONDS=60

# --- Sim scenario fast-forward ----------------------------------------------

# Override scenario.yaml's pump-anomaly timing without rebuilding the sim
# image. Defaults from scenario.yaml: begin=150 (t=2:30), ramp=90 seconds,
# slope=1.0 mm/s² — Vibration crosses 100 at t≈3:48, fire at t≈3:53.
# For fast iteration: begin=5, ramp=10, slope=10 → cross at t≈13s, fire at
# t≈14s (with DWELL=1). For rehearsal pacing leave unset.
SIM_PUMP_ANOMALY_BEGIN_SEC=
SIM_PUMP_ANOMALY_RAMP_SEC=
SIM_PUMP_ANOMALY_SLOPE=
