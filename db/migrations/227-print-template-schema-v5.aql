// ============================================================================
// PrintTemplate Migration: v2/v4 to v5 Schema Format
// ============================================================================
//
// This migration:
// 1. Converts schemas from keyed objects to arrays with 'name' property (v5 format)
// 2. Embeds link data (linkType, linkValue) directly into schema fields
// 3. Ensures backgroundColor is present in text fields (defaults to empty string)
// 4. Adds pdfmeVersion marker
//
// IMPORTANT: Run a DRY RUN first to preview changes before applying!
// ============================================================================

// ------------------------------------------------------------------------
// ------------------------------ DRY RUN ---------------------------------
// ------------------------------------------------------------------------
// Preview what the migration will do (does NOT modify data)

FOR doc IN PrintTemplate
  FILTER doc.template != null AND doc.template.schemas != null

  // Check if already migrated (v5 schemas are arrays of arrays)
  FILTER !IS_ARRAY(doc.template.schemas[0]) OR LENGTH(doc.template.schemas) == 0

  LET links = doc.links || {}

  LET migratedSchemas = (
    FOR pageSchema IN doc.template.schemas
      // Each pageSchema is currently { fieldName: { type, position, ... }, ... }
      LET migratedFields = (
        FOR fieldName IN ATTRIBUTES(pageSchema)
          LET fieldSpec = pageSchema[fieldName]
          LET fieldLink = links[fieldName] || {}

          // Build the new field with 'name' property and embedded link data
          LET baseField = MERGE(
            fieldSpec,
            {
              name: fieldName,
              linkType: fieldLink.type || 'none',
              linkValue: fieldLink.value || ''
            }
          )

          // For text fields, ensure backgroundColor exists
          LET finalField = fieldSpec.type == 'text'
            ? MERGE(baseField, {
                backgroundColor: fieldSpec.backgroundColor || ''
              })
            : baseField

          RETURN finalField
      )
      RETURN migratedFields
  )

  RETURN {
    _key: doc._key,
    name: doc.name,
    originalSchemaFormat: doc.template.schemas,
    migratedSchemaFormat: migratedSchemas,
    linksToEmbed: links
  }

// ------------------------------------------------------------------------
// ------------------------------ APPLY MIGRATION -------------------------
// ------------------------------------------------------------------------
// Uncomment and run this section AFTER reviewing the dry run results

