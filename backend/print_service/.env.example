# Progress Print Service — configuration
# Copy this file to .env and fill in values for your deployment.
# All keys use the PROGRESS_PRINT_SERVICE_ prefix.
#
# Note: if a key is also set as an OS environment variable, the environment
# variable takes priority over the value in this file.

# URL of the Progress API server (use the LAN IP for Windows deployments)
# Example: http://192.168.1.100:8000/api
PROGRESS_PRINT_SERVICE_API_URL=http://192.168.1.100:8000/api

# Username for the print service account on the Progress API
PROGRESS_PRINT_SERVICE_USERNAME=print_service

# Password for the print service account
PROGRESS_PRINT_SERVICE_API_PASSWORD=changeme

# How to handle non-ASCII characters in ZPL labels.
# "replace" silently substitutes "?" (default); "error" raises an error.
PROGRESS_PRINT_SERVICE_NON_ASCII=replace

# Seconds to wait before reconnecting after a dropped SSE connection.
PROGRESS_PRINT_SERVICE_RECONNECT_DELAY=5.0

# REQUIRED for per-printer Windows installs.
# Set to the exact printer name this service instance should handle.
# If omitted, the service subscribes to ALL print jobs (wildcard mode —
# intended for legacy Docker deployments only, not per-printer Windows installs).
# Example value matches the printer name configured in the Progress admin panel.
PROGRESS_PRINT_SERVICE_PRINTER_KEY=Warehouse ZPL Printer 1
